<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title || 'Employee Management System' %></title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body class="<%= typeof isWelcome !== 'undefined' && isWelcome ? 'welcome-body' : '' %>">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
      <div class="container-fluid">
        <a class="navbar-brand" href="/dashboard">Employee Management</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navMenu">
          <ul class="navbar-nav ms-auto align-items-center">
            <li class="nav-item"><a class="nav-link" href="/api-docs">API Docs</a></li>
            <% if (user) { %>
            <li class="nav-item"><a class="nav-link" href="/dashboard">Dashboard</a></li>
            <li class="nav-item"><a class="nav-link" href="/employees">Employees</a></li>
            <% if (user.role === 'admin') { %>
            <li class="nav-item"><a class="nav-link" href="/employees/add">Add Employee</a></li>
            <% } %>
            <li class="nav-item"><a class="nav-link" href="/logout">Logout</a></li>
            <li class="nav-item d-flex align-items-center ms-3">
              <span class="navbar-text text-white small me-2">Role: <%= user.role %></span>
              <button id="theme-toggle" type="button" class="btn btn-outline-light btn-sm">Dark Mode</button>
            </li>
            <% } else { %>
            <li class="nav-item"><a class="nav-link" href="/login">Login</a></li>
            <% } %>
          </ul>
        </div>
      </div>
    </nav>
    <main class="<%= typeof isWelcome !== 'undefined' && isWelcome ? 'p-0' : 'container py-4' %>">
